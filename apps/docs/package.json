		"@melon/sync": "workspace:*",
		"@melon/sync-server": "workspace:*",
		"@tanstack/react-router": "1.170.8",
		"@tanstack/react-start": "1.168.13",
		"fumadocs-core": "^16.9.3",
		"fumadocs-mdx": "^15.0.10",
		"fumadocs-typescript": "^5.2.6",
		"fumadocs-ui": "^16.9.3",
		"lucide-react": "^0.563.0",
		"react": "^19.2.0",
