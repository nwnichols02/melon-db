{
  "name": "playground-rn",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "bun run start:expo-go",
    "start:expo-go": "EXPO_OFFLINE=1 MELON_ENV=expo-go bun --env-file=./env/.env.expo-go run expo:start",
    "start:expo-go:clear": "EXPO_OFFLINE=1 MELON_ENV=expo-go bun --env-file=./env/.env.expo-go run expo:start:clear",
    "ios:expo-go": "EXPO_OFFLINE=1 MELON_ENV=expo-go bun --env-file=./env/.env.expo-go run expo:ios",
    "expo:start": "expo start",
    "expo:start:clear": "expo start --clear",
    "expo:ios": "expo start --ios",
    "expo:prebuild": "expo prebuild",
    "expo:prebuild:clean": "expo prebuild --clean",
    "expo:run:ios": "expo run:ios",
    "expo:run:android": "expo run:android",
    "expo:start:dev-client": "expo start --dev-client",
    "prebuild:dev": "MELON_ENV=development-build bun --env-file=./env/.env.development-build run expo:prebuild:clean",
    "install:dev-build": "bun run prebuild:dev && bun run run:ios:dev",
    "run:ios:dev": "MELON_ENV=development-build bun --env-file=./env/.env.development-build run expo:run:ios",
    "run:android:dev": "MELON_ENV=development-build bun --env-file=./env/.env.development-build run expo:run:android",
    "start:dev-build": "EXPO_OFFLINE=1 MELON_ENV=development-build bun --env-file=./env/.env.development-build run expo:start:dev-client",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@melon/db": "workspace:*",
    "@melon/db-devtools": "workspace:*",
    "@melon/db-query": "workspace:*",
    "@melon/db-react": "workspace:*",
    "@melon/db-sqlite": "workspace:*",
    "@melon/sync": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.5",
    "expo-dev-client": "~6.0.20",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@melon/db-sqlite-native": "workspace:*",
    "@types/react": "~19.1.10",
    "typescript": "^5"
  }
}
