{
  "name": "melon-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run typecheck:apps",
    "build": "bun run --filter './packages/*' build",
    "check": "bunx biome check packages",
    "demo": "bun run --filter playground-node demo",
    "demo:sync": "bun run --filter playground-node sync-demo",
    "demo:sync:http": "bun run --filter playground-node sync-http-demo",
    "sync-server": "bun run packages/melon-sync-server/src/bin/sync-server.ts",
    "postgres:up": "docker compose up -d",
    "postgres:down": "docker compose down",
    "sync-server:postgres": "DATABASE_URL=postgres://melon:melon@localhost:5433/melon_sync bun run sync-server",
    "demo:sync:postgres": "DATABASE_URL=postgres://melon:melon@localhost:5433/melon_sync bun run --filter playground-node sync-postgres-demo",
    "dev:rn": "bun run --filter playground-rn start",
    "dev:rn:dev": "bun run --filter playground-rn-dev install:ios",
    "dev:rn:dev:android": "bun run --filter playground-rn-dev install:android",
    "dev:rn:dev:start": "bun run --filter playground-rn-dev start",
    "dev:web": "bun run --filter playground-web dev",
    "dev:docs": "bun run --filter docs dev",
    "build:docs": "bun run docs:api && bun run --filter docs build",
    "ios:rn": "bun run --filter playground-rn ios",
    "ios:rn:clear": "bun run --filter playground-rn start:clear",
    "bench": "bun run packages/melon-db-sqlite/__benchmarks__/insert-query.bench.ts",
    "bench:full": "bun run packages/melon-db-sqlite/__benchmarks__/insert-query.bench.ts --scale=all",
    "bench:compare": "bun run packages/melon-db-sqlite/__benchmarks__/compare-watermelon.bench.ts",
    "bench:compare:ci": "bun run packages/melon-db-sqlite/__benchmarks__/compare-watermelon.bench.ts --scale=10k --json",
    "bench:compare:docs": "bun run packages/melon-db-sqlite/__benchmarks__/write-docs-artifact.ts",
    "melon-codemod": "bun run packages/melon-db-codemods/src/bin/melon-codemod.ts",
    "docs:api": "bun run --filter docs docs:api",
    "typecheck:apps": "bun run --filter playground-rn typecheck && bun run --filter playground-rn-dev typecheck && bun run --filter playground-web typecheck && bun run --filter docs typecheck",
    "melon-prisma": "bun run packages/melon-db-prisma/src/bin/melon-prisma.ts",
    "build:packages": "bun tooling/release/build-all.ts",
    "pack:packages": "bun run build:packages && bun tooling/release/pack-all.ts",
    "release:smoke": "bun tooling/release/smoke-consumer.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "typescript": "^5"
  },
  "trustedDependencies": ["better-sqlite3"],
  "overrides": {
    "better-sqlite3": "12.10.0"
  }
}
