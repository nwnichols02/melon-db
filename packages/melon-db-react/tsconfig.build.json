{
  "extends": "../../tooling/tsconfig.build.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "paths": {
      "@melon/db": ["../melon-db/dist/index.d.ts"],
      "@melon/db-query": ["../melon-db-query/dist/index.d.ts"],
      "@melon/db-query-mango": ["../melon-db-query-mango/dist/index.d.ts"],
      "@melon/db-prisma": ["../melon-db-prisma/dist/index.d.ts"],
      "@melon/sync": ["../melon-sync/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/*.test.ts"]
}
