{
	"name": "@melon-db/db-sqlite-native",
	"version": "0.1.0-alpha.0",
	"description": "Melon JSI/TurboModule SQLite for React Native development builds",
	"main": "./dist/index.js",
	"react-native": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"scripts": {
		"typecheck": "bunx tsc -p tsconfig.json --noEmit",
		"test": "bun test"
	},
	"codegenConfig": {
		"name": "MelonSQLiteSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.melon.sqlite",
			"modulesProvider": {
				"MelonSQLite": "MelonSQLiteModule"
			}
		},
		"ios": {
			"modulesProvider": {
				"MelonSQLite": "MelonSQLite"
			}
		}
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"devDependencies": {
		"@types/react": "~19.1.10",
		"react-native": "0.81.5",
		"typescript": "^5"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nwnichols02/melon-db.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"ios",
		"android",
		"cpp",
		"melon-sqlite-native.podspec",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./src/index.ts"
		}
	},
	"author": "Nate Nichols <nwnichols02@gmail.com>",
	"homepage": "https://github.com/nwnichols02/melon-db#readme",
	"bugs": {
		"url": "https://github.com/nwnichols02/melon-db/issues"
	}
}
