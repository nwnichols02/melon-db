{
	"name": "@melon/db-sqlite-native",
	"version": "0.0.1",
	"description": "Melon JSI/TurboModule SQLite for React Native development builds",
	"main": "./src/index.ts",
	"react-native": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"typecheck": "bunx tsc -p tsconfig.json --noEmit",
		"test": "bun test"
	},
	"codegenConfig": {
		"name": "MelonSQLiteSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.melon.sqlite"
		},
		"ios": {
			"modulesProvider": {
				"MelonSQLite": "MelonSQLite"
			}
		}
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"devDependencies": {
		"@types/react": "~19.1.10",
		"react-native": "0.81.5",
		"typescript": "^5"
	}
}
