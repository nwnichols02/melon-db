generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id        String   @id
  title     String
  status    String
  priority  Int
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
  updatedAt DateTime @updatedAt
}

model Project {
  id    String @id
  name  String
  tasks Task[]
}
