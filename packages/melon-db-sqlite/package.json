{
	"name": "@melon/db-sqlite",
	"version": "0.0.0-alpha",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./expo": "./src/expo.ts",
		"./node": "./src/node.ts"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "bunx tsc -p tsconfig.json --noEmit",
		"build": "bun build ./src/index.ts --outdir ./dist --target node"
	},
	"dependencies": {
		"@melon/db": "workspace:*"
	},
	"peerDependencies": {
		"better-sqlite3": ">=11.0.0",
		"expo-sqlite": ">=15.0.0"
	},
	"peerDependenciesMeta": {
		"better-sqlite3": {
			"optional": true
		},
		"expo-sqlite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@melon/db-devtools": "workspace:*",
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
